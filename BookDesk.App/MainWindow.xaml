<Window x:Class="BookDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BookDesk — каталог книг"
        Height="560" Width="820"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="White"
        FontFamily="Segoe UI" FontSize="13">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Каталог книг (учебная версия)"
               FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>

    <TextBlock x:Name="ModeLabel" Grid.Row="1"
               Margin="0,0,0,12" Foreground="#444"/>

    <DockPanel Grid.Row="2" Margin="0,0,0,10" LastChildFill="True">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
        <Button x:Name="SearchButton" Content="Найти" Width="90" Margin="0,0,6,0" Click="SearchButton_Click"/>
        <Button x:Name="ResetButton" Content="Сбросить" Width="90" Click="ResetButton_Click"/>
      </StackPanel>
      <TextBox x:Name="SearchBox" Height="28" VerticalContentAlignment="Center"
               ToolTip="Поиск по названию"/>
    </DockPanel>

    <DataGrid x:Name="BooksGrid" Grid.Row="3"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              SelectionMode="Single"
              HeadersVisibility="Column"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              GridLinesVisibility="Horizontal"
              AlternatingRowBackground="#F7F7F7"
              SelectionChanged="BooksGrid_SelectionChanged">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
        <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="120"/>
        <DataGridTextColumn Header="Экз." Binding="{Binding Copies}" Width="60"/>
        <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="80"/>
        <DataGridTextColumn Header="Итого" Binding="{Binding Total}" Width="90"/>
      </DataGrid.Columns>
    </DataGrid>

    <Grid Grid.Row="4" Margin="0,12,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="80"/>
        <ColumnDefinition Width="90"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,8,0">
        <TextBlock Text="Название" Margin="0,0,0,2"/>
        <TextBox x:Name="TitleBox" Height="28" VerticalContentAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,8,0">
        <TextBlock Text="Жанр" Margin="0,0,0,2"/>
        <TextBox x:Name="GenreBox" Height="28" VerticalContentAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Margin="0,0,8,0">
        <TextBlock Text="Экземпляры" Margin="0,0,0,2"/>
        <TextBox x:Name="CopiesBox" Height="28" VerticalContentAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Column="3">
        <TextBlock Text="Цена" Margin="0,0,0,2"/>
        <TextBox x:Name="PriceBox" Height="28" VerticalContentAlignment="Center"/>
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,8">
      <Button Content="Добавить" Width="110" Margin="0,0,8,0" Click="AddButton_Click"/>
      <Button Content="Изменить выбранную" Width="160" Margin="0,0,8,0" Click="EditButton_Click"/>
      <Button Content="Удалить выбранную" Width="150" Click="DeleteButton_Click"/>
    </StackPanel>

    <TextBlock x:Name="StatusLabel" Grid.Row="6" Foreground="#333" TextWrapping="Wrap"/>
  </Grid>
</Window>
